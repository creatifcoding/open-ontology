{
  "name": "@open-ontology/ontology",
  "version": "0.1.0",
  "description": "Portable ontology model and adapters for Forma and Triplex",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "preludes",
    "libraries",
    "docs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./forma": {
      "types": "./dist/forma.d.ts",
      "import": "./dist/forma.js"
    },
    "./ir": {
      "types": "./dist/ir.d.ts",
      "import": "./dist/ir.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./preludes/*": "./preludes/*",
    "./libraries/*": "./libraries/*"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm site:check",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "tsx examples/field-service/run.ts",
    "example:support-desk": "tsx examples/support-desk/run.ts",
    "example:github": "tsx examples/github/run.ts",
    "example:onboarded": "tsx examples/onboarded/run.ts",
    "site:export-onboarded": "tsx scripts/export-onboarded.ts",
    "model:check": "tsx scripts/check-model.ts",
    "account:check": "tsx scripts/check-account.ts",
    "site:check": "node apps/site/check.mjs",
    "site:dev": "wrangler dev --config apps/site/wrangler.jsonc",
    "site:deploy": "wrangler deploy --config apps/site/wrangler.jsonc"
  },
  "dependencies": {
    "@formalang/ts": "0.3.0",
    "@triplex-build/triplex": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "effect": "4.0.3",
    "tsdown": "0.20.0",
    "tsx": "4.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.2",
    "wrangler": "4.142.0"
  },
  "peerDependencies": {
    "effect": "^4.0.3"
  },
  "pnpm": {
    "overrides": {
      "@formalang/ts@0.3.0>effect": "$effect",
      "@triplex-build/triplex@0.2.0>effect": "$effect"
    },
    "patchedDependencies": {
      "@triplex-build/triplex@0.2.0": "patches/@triplex-build__triplex@0.2.0.patch"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0"
}
